# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL controls where the frontend sends API requests.
# Examples:
# - Using CRA proxy (recommended in development): leave commented, package.json "proxy" handles /api to backend on :3001
# - Direct backend URL (production or no proxy): uncomment and set full origin + basePath
# REACT_APP_API_BASE_URL=http://localhost:3001/api

