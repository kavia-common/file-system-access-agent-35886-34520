# Development environment variables for CRA dev server behavior
# Copy this file to `.env.development.local` for local development customizations.

# Option 1 (recommended): Allow specific external hostnames (Webpack Dev Server v4 behavior via CRA 5)
# Set to a comma-separated list of hostnames you plan to use to access the dev server.
# Examples:
#   ALLOWED_HOSTS=localhost,127.0.0.1
#   ALLOWED_HOSTS=localhost,127.0.0.1,preview.example.com
#   ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Note: For CRA 5, Webpack Dev Server infers allowed hosts from this.
ALLOWED_HOSTS=localhost,127.0.0.1

# Option 2 (fallback for tunneling/Docker): Disable host check (use only in development)
# When true, CRA dev server disables strict host checking so remote/tunnel/IP access works.
# WARNING: Only use in local dev and do NOT enable in production.
# Uncomment to use:
# DANGEROUSLY_DISABLE_HOST_CHECK=true

# Bind address (0.0.0.0 allows access from remote hosts and Docker networks)
HOST=0.0.0.0

# Port for CRA dev server
PORT=3000

# Backend API base URL for the frontend (optional; defaults to /api with CRA proxy)
# REACT_APP_API_BASE_URL=http://localhost:3001/api
